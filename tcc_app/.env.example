# ---------------------------------------------------------------
# Execução LOCAL (fora do Docker). Copie para .env e preencha os <...>
#   cp .env.example .env
# ---------------------------------------------------------------
TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
SESSION_DRIVER=cookie

# Gere com: node ace generate:key   (copie o valor para aqui)
APP_KEY=<gerar-com-node-ace-generate-key>

# URL pública da API (usada para montar links de ficheiros)
APP_URL=http://localhost:3333/api

# Base de dados: em local use 127.0.0.1 (o nome "mysql" só existe dentro do Docker).
# A porta 3306 já está exposta pelo docker-compose (serviço mysql).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=adonis
DB_PASSWORD=<mesma-palavra-passe-do-MYSQL_PASSWORD-no-docker-compose>
DB_DATABASE=adonis_db

# Email (opcional para desenvolvimento; obrigatório pelo schema, pode ficar com valores fictícios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<email>
SMTP_PASSWORD=<palavra-passe-de-aplicacao>

LINK_FORGET_PASSWORD=http://localhost:5173/redefinir-senha
LINK_URL_LOGO=http://localhost:3333/

# Redis: exigido pelo schema; em local aponte para 127.0.0.1 (só é usado pelas filas/notificações)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=notifications:
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

INVOICE_STATE_IN_PROGRESS='Em curso'
INVOICE_STATE_OVERDUE='Vencida'
INVOICE_STATE_IN_DISPUTE="Em disputa"
PROCESS_STATE_PROGRESS="Em curso"
